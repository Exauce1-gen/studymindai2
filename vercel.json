{
  "rewrites": [
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/check-expired-premium",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/check-streak-reminders",
      "schedule": "0 19 * * *"
    }
  ]
}
